[Unit]
Description=Portfolio — mantenimiento semanal
After=network-online.target docker.service
# Saturday chain: if an earlier maintenance is still running (or several timers
# fire together after an outage, Persistent=true), wait for it. Ordering only
# applies to queued jobs, so a normal Saturday is unaffected, and the wait does
# not count against TimeoutStartSec.
After=masanco-mantenimiento.service
Wants=network-online.target
Requires=docker.service
# Red de seguridad final: el trap ERR del script no llega a ejecutarse si el
# kernel lo mata por memoria, si se agota TimeoutStartSec o ante un kill -9.
# En esos casos el mantenimiento desaparece sin avisar.
OnFailure=portfolio-mantenimiento-fallo.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/portfolio-mantenimiento/mantenimiento.sh
# Internal timeouts: git 120 s, build 600 s, plus the health and edge waits;
# they fit here with margin. Polybot starts at 03:00.
TimeoutStartSec=1800
# Time for the trap to clean up and send its notice after systemd's TERM.
TimeoutStopSec=300
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=portfolio-mantenimiento
