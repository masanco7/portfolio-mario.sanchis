---
import { ClientRouter } from 'astro:transitions';
import { getTranslations, type Lang } from '../i18n';

export interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** Paths of this page in each language (e.g. case pages); defaults to the two home pages. */
  paths?: { es: string; en: string };
  /** Absolute URL of the social preview image; defaults to the site-wide og-image.png. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: string;
}

const { lang = 'es', title, description, paths = { es: '/', en: '/en/' }, ogImage: ogImageProp, ogImageAlt, ogType = 'profile' } = Astro.props;
const t = getTranslations(lang);

const finalTitle = title ?? t.meta.title;
const finalDescription = description ?? t.meta.description;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const canonical = `${siteUrl}${paths[lang]}`;
const altEs = `${siteUrl}${paths.es}`;
const altEn = `${siteUrl}${paths.en}`;
// The role line and tagline are baked into this bitmap. It is generated from the
// hero strings by `npm run og` (see og-src/) — rerun it whenever hero.title or
// hero.tagline changes, or the social preview drifts from the site.
const ogImage = ogImageProp ?? `${siteUrl}/og-image.png`;
const imageAlt = ogImageAlt ?? finalTitle;
const finalOgDescription = description ?? t.meta.ogDescription;

// Self-hosted fonts: only the weights global.css uses (Inter 400/500/600, JetBrains Mono 400/500).
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
---
<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{finalTitle}</title>

    <meta name="description" content={finalDescription} />
    <meta name="author" content="Mario Sanchis Colomer" />
    <meta name="theme-color" content="#fbfbfa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0f12" media="(prefers-color-scheme: dark)" />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="es" href={altEs} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={altEs} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_ES'} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalOgDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {!ogImageProp && <meta property="og:image:width" content="1200" />}
    {!ogImageProp && <meta property="og:image:height" content="630" />}
    {!ogImageProp && <meta property="og:image:type" content="image/png" />}
    <meta property="og:image:alt" content={imageAlt} />
    {ogType === 'profile' && <meta property="profile:first_name" content="Mario" />}
    {ogType === 'profile' && <meta property="profile:last_name" content="Sanchis Colomer" />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalOgDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mario Sanchis Colomer",
      "givenName": "Mario",
      "familyName": "Sanchis Colomer",
      "jobTitle": "Full-Stack Developer",
      "address": { "@type": "PostalAddress", "addressLocality": "Valencia", "addressCountry": "ES" },
      "email": "mailto:msanchiscolomer@gmail.com",
      "alumniOf": {
        "@type": "CollegeOrUniversity",
        "name": lang === 'es' ? "Universidad de Valencia — ETSE" : "University of Valencia — ETSE",
        "department": lang === 'es' ? "Grado en Ingeniería Informática" : "BSc in Computer Engineering"
      },
      "knowsAbout": [
        "Salesforce Administration","Apex","Lightning Web Components","Flow Builder",
        "SOQL","CRM Analytics","Service Cloud","Data Security","Angular","TypeScript",
        "NestJS","FastAPI","PostgreSQL"
      ],
      "knowsLanguage": ["es", "en"],
      "sameAs": [
        "https://www.linkedin.com/in/mario-sanchis-colomer/?skipRedirect=true",
        "https://github.com/masanco7",
        "https://www.salesforce.com/trailblazer/mariosanchiscolomer"
      ]
    })} />

    <ClientRouter />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />

    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('msc-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
