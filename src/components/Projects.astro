---
import projectsEs from '../data/projects.es.json';
import projectsEn from '../data/projects.en.json';
import { projectDetails as detailsEs } from '../data/projectDetails.es';
import { projectDetails as detailsEn } from '../data/projectDetails.en';
import { getShot } from '../data/projectShots';
import ProjectCard from './ProjectCard.astro';
import ProjectModal from './ProjectModal.astro';
import { getTranslations, type Lang } from '../i18n';
import type { Project } from '../types';

const { lang = 'es' } = Astro.props as { lang?: Lang };
const t = getTranslations(lang);

const projects = (lang === 'es' ? projectsEs : projectsEn) as Project[];
const details = lang === 'es' ? detailsEs : detailsEn;
// Only projects with an entry in projectDetails.<lang>.ts get an overlay.
// Featured projects get the large cards; every other project goes to the compact list.
const FEATURED_IDS = ['gym-tracker', 'polybot', 'finance-manager'];
const featured = FEATURED_IDS.map((id) => projects.find((p) => p.id === id)).filter((p): p is Project => p !== undefined);
const others = projects.filter((p) => !FEATURED_IDS.includes(p.id));
const withDetail = projects.map((p) => details[p.id]).filter((d) => d !== undefined);
---
<section id="proyectos" class="section" aria-labelledby="projects-title">
  <div class="container">
    <p class="section-label reveal">{t.projects.sectionLabel}</p>
    <h2 id="projects-title" class="section-title reveal">{t.projects.title}</h2>
    <p class="section-intro reveal">{t.projects.intro}</p>
    <div class="projects-grid projects-grid--featured">
      {featured.map((p) => (
        <ProjectCard
          project={p}
          detailId={details[p.id] ? p.id : undefined}
          openLabel={t.projectDetail.openLabel}
          openAria={t.projectDetail.openAria}
          coverImage={details[p.id] ? getShot(p.id, details[p.id]!.hero.shot) : undefined}
          coverAlt={details[p.id]?.hero.alt}
        />
      ))}
    </div>

    <h3 class="projects-more-title reveal">{t.projects.moreTitle}</h3>
    <ul class="projects-compact" role="list">
      {others.map((p) => (
        <li class="project-compact reveal">
          <div class="project-compact-main">
            <p class="project-compact-title">
              {p.title}
              {p.host && <span class="project-host">{p.host}</span>}
              <span class="project-compact-badge">{p.badge.label}</span>
            </p>
            <p class="project-compact-summary">{p.summary}</p>
            <ul class="project-stack" role="list">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
          </div>
          {details[p.id]
            ? (
              <button type="button" class="project-link" data-pmodal-open={p.id} aria-haspopup="dialog" aria-controls={`pmodal-${p.id}`} aria-label={`${t.projectDetail.openAria}: ${p.title}`}>
                {t.projectDetail.openLabel}
              </button>
            )
            : p.links.filter((l) => l.href).map((l) => (
              <a class="project-link" href={l.href} target="_blank" rel="noopener">{l.label}</a>
            ))}
        </li>
      ))}
    </ul>
  </div>
</section>

{withDetail.map((detail) => <ProjectModal detail={detail} lang={lang} />)}
